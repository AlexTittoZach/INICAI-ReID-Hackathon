###                                                               TESTING WITH 300 FRAMES AND EXTRACTING OUTPUT AS .MP4 VIDEO FORMAT


# 1. Install/Update the library
!pip install ultralytics -q

import os
from ultralytics import YOLO
from IPython.display import Video, display

# 2. Load your Version 10 model
model = YOLO('yolov8m.pt') 

# 3. Path to the test images
video_source = '/kaggle/input/competitions/re-id-x-scalable-re-id-for-dynamic-camera-systems/Dataset/test/images/'

# 4. Run tracking with a manual frame limit
# We use stream=True to iterate through frames and stop at 300
count = 0
for result in model.track(source=video_source, persist=True, tracker="botsort.yaml", save=True, imgsz=640, conf=0.25, stream=True):
    count += 1
    if count >= 300:
        break

# 5. Display the video
# Note: YOLO saves to 'runs/detect/track/images.avi' by default or 'track2', 'track3' etc.
# This code finds the most recent 'track' folder
import glob
track_folders = sorted(glob.glob("/kaggle/working/runs/detect/track*"), key=os.path.getmtime)
if track_folders:
    latest_folder = track_folders[-1]
    video_path = os.path.join(latest_folder, "images.avi")
    if os.path.exists(video_path):
        display(Video(video_path, embed=True, width=800))
    else:
        print(f"Video file not found in {latest_folder}")
else:
    print("No tracking folders found.")


###                                                                         Combining the 300 processed frames to video


import cv2
import os
import glob

# 1. Path to your processed frames
image_folder = '/kaggle/working/runs/detect/track'
video_name = '/kaggle/working/reid_demo.mp4'

# 2. Get sorted list of images
images = sorted(glob.glob(os.path.join(image_folder, "*.jpg")))

if not images:
    print("No images found in the track folder!")
else:
    # 3. Read the first image to get dimensions
    frame = cv2.imread(images[0])
    height, width, layers = frame.shape

    # 4. Initialize VideoWriter (using 'mp4v' for better compatibility)
    fourcc = cv2.VideoWriter_fourcc(*'mp4v') 
    video = cv2.VideoWriter(video_name, fourcc, 20.0, (width, height))

    print(f"Stitching {len(images)} images into video...")
    for image in images:
        video.write(cv2.imread(image))

    video.release()
    print(f"✅ Success! Video saved at: {video_name}")

# 5. Display the final result
from IPython.display import Video, display
display(Video(video_name, embed=True, width=800))
